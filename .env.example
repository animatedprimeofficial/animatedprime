# ---------------------------------------------------------------------------
# AnimatedPrime — environment
#
# Copy to `.env.local` and fill in what you have. Every variable is optional:
# with none of them set the site runs on the curated offline catalogue and
# shows the notify-me flow instead of an APK download.
# ---------------------------------------------------------------------------

# --- Movie metadata + official artwork -------------------------------------
# IMDb has no public API, so live metadata comes from TMDB (the same titles,
# posters served from image.tmdb.org, used under TMDB's terms).
# Get a key at https://www.themoviedb.org/settings/api — either auth style works.
# v3 API key:
TMDB_API_KEY=cf0fee785fb99a1911be2c5703e0f5f6
# ...or a v4 read access token (takes precedence when both are set):
TMDB_ACCESS_TOKEN=eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiJjZjBmZWU3ODVmYjk5YTE5MTFiZTJjNTcwM2UwZjVmNiIsIm5iZiI6MTc5MTM4OTkyOC43NCwic3ViIjoiNmFjNjcwZThjZjJlOTE1MDgxZjVlN2UyIiwic2NvcGVzIjpbImFwaV9yZWFkIl0sInZlcnNpb24iOjF9.3QW_I1hiG38s5R2Nte5FdZYXimzvV5D3V-wNti4uh7U

# --- Android release -------------------------------------------------------
# Preferred: drop the signed build into public/downloads as
#   animatedprime-android-<version>.apk
# and the UI reads the real size + SHA-256 from the file. Everything below is
# only needed when the APK is hosted elsewhere.
ANDROID_APK_URL=
ANDROID_APK_VERSION=1.4.0
ANDROID_APK_CHANNEL=stable
ANDROID_MIN_ANDROID=Android 9 (API 28)
ANDROID_APK_SIZE=
ANDROID_APK_SHA256=
ANDROID_APK_RELEASED_AT=

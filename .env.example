[TEMPLATE]
# ---------------------------------------------------------------------------
# AnimatedPrime — environment
#
# Copy to `.env.local` and fill in what you have. Everything here is optional:
# with none of it set the site runs on the curated offline catalogue and shows
# the notify-me flow instead of an APK download.
#
# Nothing in this file is loaded at runtime — it is documentation. Never put a
# real key in it: it is committed, and `.env.local` is not.
# ---------------------------------------------------------------------------

# --- Movie metadata + official artwork -------------------------------------
# IMDb has no public API, so live metadata comes from TMDB (the same titles,
# posters served from image.tmdb.org, used under TMDB's terms).
# Get a key at https://www.themoviedb.org/settings/api — either auth style works.
# v3 API key:
TMDB_API_KEY=your-tmdb-v3-api-key
# ...or a v4 read access token (takes precedence when both are set):
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# --- Android release -------------------------------------------------------
# Preferred: drop the signed build into public/downloads as
#   animatedprime-android-<version>.apk
# and the UI reads the version off the file name and the real size + SHA-256
# off the bytes. Everything below is only needed when the APK is hosted
# elsewhere, or to override what `public/downloads/release.json` declares.
#
# The minimum and target OS levels are not guesses — read them off the build:
#   aapt2 dump badging animatedprime-android-<version>.apk | grep sdkVersion
ANDROID_APK_URL=
ANDROID_APK_VERSION=1.0.0
ANDROID_APK_CHANNEL=stable
ANDROID_MIN_ANDROID=Android 6.0 (API 23)
ANDROID_TARGET_ANDROID=Android 16 (API 36)
ANDROID_APK_SIZE=
ANDROID_APK_SHA256=
ANDROID_APK_RELEASED_AT=

# --- Mirror -----------------------------------------------------------------
# A second, public route to the same artifact, shown beside the checksummed
# download and used as the fallback when no local build is shipped. Normally
# set in `public/downloads/release.json`; these override it.
ANDROID_APK_MIRROR_URL=
ANDROID_APK_MIRROR_LABEL=

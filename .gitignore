# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build
next-env.d.ts

# production
/dist

# testing & coverage
/coverage
.nyc_output
playwright-report
test-results

# typescript
*.tsbuildinfo

# misc
.DS_Store
Thumbs.db
*.pem
.vercel
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit .env.example instead
.env
.env*.local

# local agent / editor state
.freebuff/
.idea/
.vscode/*
!.vscode/extensions.json

# large media that should live in a release, not the repo
/public/downloads/*.apk
/public/downloads/*.aab

# staging folder for signed Android builds — a release artifact, never a commit
/apk/
